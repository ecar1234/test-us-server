{
    "version": "0.2.0",
    "configurations": [
       {
            "type": "node",
            "request": "launch",
            "name": "Debug API Server", 
            "args": ["${workspaceFolder}/src/index.ts"], 
            "runtimeArgs": ["-r", "ts-node/register"],
            "skipFiles": ["<node_internals>/**"],
            "console": "integratedTerminal"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Worker", 
            "args": ["${workspaceFolder}/src/workers/index.ts"], 
            "runtimeArgs": ["-r", "ts-node/register"],
            "skipFiles": ["<node_internals>/**"],
            "console": "integratedTerminal",
        }
    ],
    "compounds": [
        {
            "name": "🚀 Debug ALL (API + Worker)",
            "configurations": ["Debug API Server", "Debug Worker"]
        }
    ]
}
