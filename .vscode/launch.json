{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug TS-Node",
            "args": ["${workspaceFolder}/src/index.ts"],
            "runtimeArgs": ["-r", "ts-node/register"],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "console": "integratedTerminal"
        }
    ]
}
